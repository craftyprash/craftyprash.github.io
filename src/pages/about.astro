---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Crafty Prash">
  <div class="about-page">
    <h1>About</h1>
    <div class="content">
      <p>
        I'm Prashant — <strong>CraftyPrash</strong> online. A hands-on CTO with 20+ years
        building enterprise systems, still happiest in the terminal.
      </p>
      <p>
        I care as much about the tools and the workflow as the product itself. This site is
        where I keep working notes and the occasional guide — things I've worked out and want
        to find again. Nothing polished for its own sake; just what's useful.
      </p>
      <p>
        I build with Java / Quarkus, Rust, and PostgreSQL on a keyboard-driven Arch and macOS
        setup, and I ship developer and ops tools at
        <a href="https://github.com/craftyshelf" target="_blank" rel="noopener">@craftyshelf</a>.
        I also wrote a book — <em>Java EE 8 and Angular</em>.
      </p>
      <figure class="setup">
        <img src="/images/voyager-zsa.jpg" alt="My daily driver — a ZSA Voyager split keyboard" />
        <figcaption>My daily driver — a ZSA Voyager.</figcaption>
      </figure>
      <p class="links">
        <a href="https://github.com/craftyprash" target="_blank" rel="noopener"><i class="ph ph-github-logo"></i> github.com/craftyprash</a>
        <a href="https://github.com/craftyshelf" target="_blank" rel="noopener"><i class="ph ph-wrench"></i> github.com/craftyshelf</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 720px;
    margin: 0 auto;
  }

  .about-page h1 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }

  .content p {
    font-size: 1.0625rem;
    color: var(--text-primary);
    line-height: 1.65;
    margin: 1.5em 0;
  }

  .content .setup {
    margin: 2rem 0;
  }

  .content .setup img {
    width: 100%;
    max-width: 520px;
    border-radius: 8px;
    border: 1px solid var(--border);
    display: block;
  }

  .content .setup figcaption {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin-top: 0.5rem;
  }

  .content .links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .content .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
  }
</style>
